<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Liburutegia.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>

            <!-- KOLOREAK -->
            <Color x:Key="Nagusia">#0F4C98</Color>
            <Color x:Key="NagusiaArina">#1E6BC4</Color>
            <Color x:Key="Hautatua">#E3E8F2</Color>
            <Color x:Key="Hondoa">#F3F5F9</Color>
            <Color x:Key="Testua">#1F2933</Color>
            <Color x:Key="Grisa">#6B7280</Color>
            <Color x:Key="Okerra">#C62828</Color>

            <!-- TESTUAK -->
            <Style x:Key="Goiburua" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
            </Style>
            <Style x:Key="Etiketa" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>
            <Style x:Key="Balioa" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>
            <Style x:Key="Errorea" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource Okerra}"/>
            </Style>

            <!-- TXARTELAK (zerrendetako elementuak eta panelak) -->
            <Style x:Key="Txartela" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="#D5DAE3"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource Hautatua}"/>
                                    <Setter Property="Stroke" Value="{StaticResource Nagusia}"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- BOTOIAK -->
            <Style x:Key="BotoiNagusia" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Nagusia}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#B8BFCC"/>
                                    <Setter Property="TextColor" Value="#F3F5F9"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="BotoiTxikia" TargetType="Button" BasedOn="{StaticResource BotoiNagusia}">
                <Setter Property="BackgroundColor" Value="{StaticResource NagusiaArina}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="HeightRequest" Value="34"/>
            </Style>
            <Style x:Key="BotoiBarra" TargetType="Button" BasedOn="{StaticResource BotoiNagusia}">
                <Setter Property="BackgroundColor" Value="{StaticResource NagusiaArina}"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style x:Key="BotoiGorria" TargetType="Button" BasedOn="{StaticResource BotoiNagusia}">
                <Setter Property="BackgroundColor" Value="{StaticResource Okerra}"/>
            </Style>

            <!-- FORMULARIOAK -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource Grisa}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="TitleColor" Value="{StaticResource Grisa}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
