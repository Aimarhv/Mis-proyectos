<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Liburutegia"
             x:Class="Liburutegia.LiburuakPage"
             Title="Liburuak"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Hondoa}">

    <Grid RowDefinitions="Auto,*" Padding="32,26,32,24" RowSpacing="22">

        <!-- ============ GOIBURUA ============ -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label x:Name="LblAgurra" Text="Kaixo!" Style="{StaticResource Etiketa}" TextColor="{StaticResource Azentua}"/>
                <Label Text="Liburutegia" Style="{StaticResource OrriIzenburua}"/>
                <Label Text="Bilatu, arakatu eta kudeatu zure bilduma." Style="{StaticResource OrriAzpititulua}"/>
            </VerticalStackLayout>

            <!-- Ekintza nagusiak (lehen beheko barran zeudenak) -->
            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Button Text="+  Egile berria" Style="{StaticResource BotoiBigarrena}" Clicked="OnEgileBerria"/>
                <Button Text="Editatu liburua" Style="{StaticResource BotoiBigarrena}" Clicked="OnEditatuLiburua"/>
                <Button Text="+  Liburu berria" Style="{StaticResource BotoiNagusia}" Clicked="OnLiburuBerria"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ============ EDUKIA ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,1.45*" ColumnSpacing="28">

            <!-- EZKERRA: estatistikak + bilatzailea + zerrenda -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">

                <!-- Estatistika txikiak -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Estatistika}">
                        <VerticalStackLayout>
                            <Label x:Name="LblKopLiburuak" Text="0" FontFamily="{StaticResource Serif}" FontSize="24"
                                   FontAttributes="Bold" TextColor="{StaticResource Nagusia}"/>
                            <Label Text="Liburu" Style="{StaticResource Etiketa}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Estatistika}">
                        <VerticalStackLayout>
                            <Label x:Name="LblKopEskuragarri" Text="0" FontFamily="{StaticResource Serif}" FontSize="24"
                                   FontAttributes="Bold" TextColor="{StaticResource Arrakasta}"/>
                            <Label Text="Eskuragarri" Style="{StaticResource Etiketa}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Estatistika}">
                        <VerticalStackLayout>
                            <Label x:Name="LblKopEgileak" Text="0" FontFamily="{StaticResource Serif}" FontSize="24"
                                   FontAttributes="Bold" TextColor="{StaticResource Azentua}"/>
                            <Label Text="Egile" Style="{StaticResource Etiketa}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Bilatzailea -->
                <Border Grid.Row="1" Style="{StaticResource Eremua}" Padding="12,2">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="&#xE721;" Style="{StaticResource Ikonoa}" TextColor="{StaticResource Grisa}"/>
                        <SearchBar x:Name="BilatuBarra" Grid.Column="1"
                                   Placeholder="Bilatu izenburua, egilea, ISBNa..."
                                   TextChanged="OnBilaketaAldatu"/>
                    </Grid>
                </Border>

                <!-- Irizpideak: txipak (kodean sortuak) -->
                <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="IrizpideTxipak" Spacing="6"/>
                </ScrollView>

                <Label Grid.Row="3" x:Name="LblEmaitzak" Style="{StaticResource Laguntza}" Margin="2,2,0,0"/>

                <!-- Zerrenda -->
                <CollectionView x:Name="LiburuZerrenda" Grid.Row="4"
                                SelectionMode="Single" SelectionChanged="OnLiburuaHautatu">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource Hutsa}" Margin="0,10">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="&#xE721;" Style="{StaticResource Ikonoa}" FontSize="28"
                                       TextColor="{StaticResource GrisaArina}"/>
                                <Label Text="Ez da libururik aurkitu" FontFamily="{StaticResource Serif}" FontSize="16"
                                       TextColor="{StaticResource Testua}" HorizontalOptions="Center"/>
                                <Label Text="Probatu beste hitz batekin edo aldatu irizpidea."
                                       Style="{StaticResource Laguntza}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:Liburua">
                            <Border Style="{StaticResource Txartela}" Padding="12,10">
                                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                                    <!-- Azal txikia -->
                                    <Border Background="{Binding AzalaBrush}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 2,6,2,6" WidthRequest="46" HeightRequest="64">
                                        <Grid>
                                            <BoxView WidthRequest="5" HorizontalOptions="Start" Color="#000000" Opacity="0.18"/>
                                            <Label Text="{Binding Hizkia}" FontFamily="{StaticResource Serif}" FontSize="22"
                                                   FontAttributes="Bold" TextColor="White" Opacity="0.92"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding Izenburua}" FontFamily="{StaticResource Serif}" FontSize="16"
                                               FontAttributes="Bold" TextColor="{StaticResource Testua}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EgileaEtaUrtea}" FontSize="13" TextColor="{StaticResource Grisa}"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <!-- Egoera pilula -->
                                    <Border Grid.Column="2" Style="{StaticResource Pilula}"
                                            BackgroundColor="{Binding EskuragarriHondoa}">
                                        <Label Text="{Binding EskuragarriTestua}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding EskuragarriKolorea}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- ESKUINA: xehetasunak (irakurtzeko soilik) -->
            <ScrollView Grid.Column="1">
                <Grid>
                    <!-- Ezer aukeratu gabe -->
                    <Border x:Name="HutsaTxartela" Style="{StaticResource Hutsa}" VerticalOptions="Start" Padding="24,70">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="&#xE736;" Style="{StaticResource Ikonoa}" FontSize="40"
                                   TextColor="{StaticResource Azentua}"/>
                            <Label Text="Aukeratu liburu bat" FontFamily="{StaticResource Serif}" FontSize="20"
                                   FontAttributes="Bold" TextColor="{StaticResource Testua}" HorizontalOptions="Center"/>
                            <Label Text="Ezkerreko zerrendan klik eginez gero, bere fitxa hemen agertuko da."
                                   Style="{StaticResource OrriAzpititulua}" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Liburuaren fitxa -->
                    <Border x:Name="XehetasunTxartela" Style="{StaticResource Panela}" IsVisible="False"
                            VerticalOptions="Start">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="30">

                            <!-- Azal handia -->
                            <Border x:Name="Azala" WidthRequest="170" HeightRequest="245" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 3,12,3,12" VerticalOptions="Start">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="4,10" Radius="20" Opacity="0.25"/>
                                </Border.Shadow>
                                <Grid>
                                <BoxView WidthRequest="9" HorizontalOptions="Start" Color="#000000" Opacity="0.2"/>
                                <Grid RowDefinitions="*,Auto" Padding="22,20,16,18">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                                        <BoxView HeightRequest="1" WidthRequest="40" Color="White" Opacity="0.5"/>
                                        <Label x:Name="AzalaTestua" TextColor="White" FontSize="20" FontAttributes="Bold"
                                               FontFamily="{StaticResource Serif}" HorizontalTextAlignment="Center"/>
                                        <BoxView HeightRequest="1" WidthRequest="40" Color="White" Opacity="0.5"/>
                                    </VerticalStackLayout>
                                    <Label x:Name="AzalaEgilea" Grid.Row="1" TextColor="White" Opacity="0.8" FontSize="11"
                                           CharacterSpacing="1" TextTransform="Uppercase" HorizontalTextAlignment="Center"/>
                                </Grid>
                                </Grid>
                            </Border>

                            <!-- Datuak -->
                            <VerticalStackLayout Grid.Column="1" Spacing="14">
                                <Label x:Name="LblIzenburua" FontFamily="{StaticResource Serif}" FontSize="28"
                                       FontAttributes="Bold" TextColor="{StaticResource Testua}"/>

                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource Pilula}" BackgroundColor="{StaticResource AzentuaLeuna}">
                                        <Label x:Name="LblGeneroa" FontSize="12" FontAttributes="Bold" TextColor="#8A5A1F"/>
                                    </Border>
                                    <Border x:Name="EskuragarriPilula" Style="{StaticResource Pilula}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Ellipse x:Name="EskuragarriPuntua" WidthRequest="7" HeightRequest="7"
                                                     VerticalOptions="Center"/>
                                            <Label x:Name="LblEskuragarri" FontSize="12" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>

                                <BoxView Style="{StaticResource Bereizlea}" Margin="0,4"/>

                                <!-- Egilea + botoia -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Egilea" Style="{StaticResource Etiketa}"/>
                                        <Label x:Name="LblEgilea" Style="{StaticResource Balioa}" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Ikusi egilea  ›" Style="{StaticResource BotoiTxikia}"
                                            VerticalOptions="Center" Clicked="OnIkusiEgilea"/>
                                </Grid>

                                <!-- Editoriala (klik eginez ireki) -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Editoriala" Style="{StaticResource Etiketa}"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnIkusiEditoriala"/>
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label x:Name="LblEditoriala" Style="{StaticResource Balioa}" FontAttributes="Bold"
                                               TextColor="{StaticResource NagusiaArina}" TextDecorations="Underline"/>
                                        <Label Text="&#xE8A7;" Style="{StaticResource Ikonoa}" FontSize="12"
                                               TextColor="{StaticResource NagusiaArina}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- ISBN + urtea -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{StaticResource GainazalaBigarrena}" Stroke="{StaticResource Ertza}"
                                            StrokeShape="RoundRectangle 10" Padding="14,10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="ISBN" Style="{StaticResource Etiketa}"/>
                                            <Label x:Name="LblISBN" Style="{StaticResource Balioa}" FontFamily="Consolas"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource GainazalaBigarrena}"
                                            Stroke="{StaticResource Ertza}" StrokeShape="RoundRectangle 10" Padding="14,10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Argitalpen-urtea" Style="{StaticResource Etiketa}"/>
                                            <Label x:Name="LblUrtea" Style="{StaticResource Balioa}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
