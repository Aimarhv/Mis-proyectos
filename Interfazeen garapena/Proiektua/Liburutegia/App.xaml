<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Liburutegia.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ KOLOREAK (paper beroa + tinta urdina + anbar ukitua) ============ -->
            <Color x:Key="Nagusia">#1E3A4C</Color>          <!-- tinta urdin iluna -->
            <Color x:Key="NagusiaArina">#2E5670</Color>
            <Color x:Key="NagusiaLeuna">#E8EEF2</Color>     <!-- hautapenaren hondoa -->
            <Color x:Key="Azentua">#C8893A</Color>          <!-- anbarra -->
            <Color x:Key="AzentuaLeuna">#F7EBDA</Color>
            <Color x:Key="Hondoa">#F6F3EE</Color>           <!-- paper beroa -->
            <Color x:Key="Gainazala">#FFFFFF</Color>
            <Color x:Key="GainazalaBigarrena">#FBF9F6</Color>
            <Color x:Key="Ertza">#E6E0D6</Color>
            <Color x:Key="Testua">#1C2430</Color>
            <Color x:Key="Grisa">#7A746B</Color>
            <Color x:Key="GrisaArina">#A9A397</Color>
            <Color x:Key="Arrakasta">#2E7D4F</Color>
            <Color x:Key="ArrakastaLeuna">#E5F2E9</Color>
            <Color x:Key="Abisua">#B5541C</Color>
            <Color x:Key="AbisuaLeuna">#FBEBDF</Color>
            <Color x:Key="Okerra">#B3261E</Color>
            <Color x:Key="OkerraLeuna">#FBE9E7</Color>

            <!-- Letra-tipoak: izenburuetarako serif klasikoa (liburutegi kutsua) -->
            <x:String x:Key="Serif">Georgia</x:String>
            <x:String x:Key="Ikonoak">Segoe MDL2 Assets</x:String>

            <!-- ============ TESTUAK ============ -->
            <Style x:Key="OrriIzenburua" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
            </Style>
            <Style x:Key="OrriAzpititulua" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource Grisa}"/>
            </Style>
            <Style x:Key="Goiburua" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
            </Style>
            <!-- Etiketa txikia, maiuskulaz (EGILEA, ISBN...) -->
            <Style x:Key="Etiketa" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="1.2"/>
                <Setter Property="TextTransform" Value="Uppercase"/>
                <Setter Property="TextColor" Value="{StaticResource Grisa}"/>
            </Style>
            <Style x:Key="Balioa" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>
            <Style x:Key="Laguntza" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource GrisaArina}"/>
            </Style>
            <Style x:Key="Errorea" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource Okerra}"/>
            </Style>
            <Style x:Key="Ikonoa" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Ikonoak}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

            <!-- ============ TXARTELAK ============ -->
            <!-- Zerrendetako elementuak (hautagarriak) -->
            <Style x:Key="Txartela" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Gainazala}"/>
                <Setter Property="Stroke" Value="{StaticResource Ertza}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Stroke" Value="{StaticResource GrisaArina}"/>
                                    <Setter Property="BackgroundColor" Value="{StaticResource GainazalaBigarrena}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource NagusiaLeuna}"/>
                                    <Setter Property="Stroke" Value="{StaticResource Nagusia}"/>
                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Panel handiak (xehetasunak, formularioak): itzal leuna -->
            <Style x:Key="Panela" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Gainazala}"/>
                <Setter Property="Stroke" Value="{StaticResource Ertza}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
                <Setter Property="Padding" Value="28,24"/>
                <Setter Property="Shadow">
                    <Shadow Brush="#1C2430" Offset="0,6" Radius="18" Opacity="0.07"/>
                </Setter>
            </Style>

            <!-- Estatistika txartel txikiak -->
            <Style x:Key="Estatistika" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Gainazala}"/>
                <Setter Property="Stroke" Value="{StaticResource Ertza}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinimumWidthRequest" Value="110"/>
            </Style>

            <!-- "Pilula" etiketak (generoa, egoera...) -->
            <Style x:Key="Pilula" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <!-- Bilatzailearen eta eremuen kutxa -->
            <Style x:Key="Eremua" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Gainazala}"/>
                <Setter Property="Stroke" Value="{StaticResource Ertza}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
                <Setter Property="Padding" Value="8,2"/>
            </Style>

            <!-- Zerrenda hutsaren mezua -->
            <Style x:Key="Hutsa" TargetType="Border">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="Stroke" Value="{StaticResource Ertza}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeDashArray" Value="4,3"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
                <Setter Property="Padding" Value="24,36"/>
            </Style>

            <!-- ============ BOTOIAK ============ -->
            <Style x:Key="BotoiNagusia" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Nagusia}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="MinimumHeightRequest" Value="42"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource NagusiaArina}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#D9D4CB"/>
                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Bigarren mailako botoia: ertz meheduna -->
            <Style x:Key="BotoiBigarrena" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Gainazala}"/>
                <Setter Property="TextColor" Value="{StaticResource Nagusia}"/>
                <Setter Property="BorderColor" Value="{StaticResource Ertza}"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="MinimumHeightRequest" Value="42"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource NagusiaLeuna}"/>
                                    <Setter Property="BorderColor" Value="{StaticResource Nagusia}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource GrisaArina}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Botoi txikia (Ikusi egilea...) -->
            <Style x:Key="BotoiTxikia" TargetType="Button" BasedOn="{StaticResource BotoiBigarrena}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="MinimumHeightRequest" Value="32"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="BackgroundColor" Value="{StaticResource NagusiaLeuna}"/>
                <Setter Property="BorderWidth" Value="0"/>
            </Style>

            <!-- Ezabatu: gorria baina lasaia -->
            <Style x:Key="BotoiGorria" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource Okerra}"/>
                <Setter Property="BorderColor" Value="#EBC3BF"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="MinimumHeightRequest" Value="42"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource OkerraLeuna}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource GrisaArina}"/>
                                    <Setter Property="BorderColor" Value="{StaticResource Ertza}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- ============ FORMULARIOAK ============ -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource GrisaArina}"/>
                <Setter Property="BackgroundColor" Value="{StaticResource GainazalaBigarrena}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="MinimumHeightRequest" Value="40"/>
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="TitleColor" Value="{StaticResource GrisaArina}"/>
                <Setter Property="BackgroundColor" Value="{StaticResource GainazalaBigarrena}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="MinimumHeightRequest" Value="40"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="BackgroundColor" Value="{StaticResource GainazalaBigarrena}"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource Testua}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource GrisaArina}"/>
                <Setter Property="CancelButtonColor" Value="{StaticResource Grisa}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource Arrakasta}"/>
                <Setter Property="ThumbColor" Value="White"/>
            </Style>
            <Style TargetType="BoxView" x:Key="Bereizlea">
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="Color" Value="{StaticResource Ertza}"/>
            </Style>

            <!-- ============ SHELL (alboko menua) ============ -->
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource Nagusia}"/>
                <Setter Property="Shell.ForegroundColor" Value="White"/>
                <Setter Property="Shell.TitleColor" Value="White"/>
                <Setter Property="Shell.FlyoutBackgroundColor" Value="{StaticResource Nagusia}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
