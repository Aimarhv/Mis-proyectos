<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="I01._02_Batzen_Ikasten.MainPage"
             Title="Batuketak Ikasten"
             BackgroundColor="#1B1B1F">

    <ScrollView>
        <Grid Padding="30,20"
              RowDefinitions="Auto,20,Auto,10,Auto,15,Auto,20,Auto,10,Auto"
              ColumnDefinitions="*,*,Auto"
              ColumnSpacing="15">

            <!-- Orriaren izenburua -->
            <Label Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Batuketak ikasten"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#A78BFA" />

            <!-- Lehen batugaia (irakurtzeko soilik, ausaz sortua) eta sortzeko botoia -->
            <Label Grid.Row="2" Grid.Column="0"
                   Text="Lehen batugaia" VerticalOptions="Center" TextColor="White" />
            <Entry x:Name="Batugaia1Entry"
                   Grid.Row="2" Grid.Column="1"
                   IsReadOnly="True"
                   TextColor="White" />
            <Button x:Name="SortuBtn"
                    Grid.Row="2" Grid.Column="2" Grid.RowSpan="3"
                    Text="Balio berriak sortu"
                    BackgroundColor="#A78BFA"
                    TextColor="#1B1B1F"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    VerticalOptions="Center"
                    Clicked="OnSortuClicked" />

            <!-- Bigarren batugaia (irakurtzeko soilik, ausaz sortua) -->
            <Label Grid.Row="4" Grid.Column="0"
                   Text="Bigarren batugaia" VerticalOptions="Center" TextColor="White" />
            <Entry x:Name="Batugaia2Entry"
                   Grid.Row="4" Grid.Column="1"
                   IsReadOnly="True"
                   TextColor="White" />

            <BoxView Grid.Row="6" Grid.ColumnSpan="3"
                     HeightRequest="1"
                     Color="White" />

            <!-- Erabiltzaileak bere erantzuna sartzeko eremua -->
            <Label Grid.Row="8" Grid.Column="0"
                   Text="Sartu zuk uste duzuna" VerticalOptions="Center" TextColor="White" />
            <Entry x:Name="EmaitzaUsteEntry"
                   Grid.Row="8" Grid.Column="1"
                   Keyboard="Numeric"
                   TextColor="White" />

            <!-- Emaitza (zuzena/okerra) eta balioztatzeko botoia -->
            <Entry x:Name="EmaitzaEntry"
                   Grid.Row="10" Grid.Column="1"
                   IsReadOnly="True"
                   TextColor="White" />
            <Button x:Name="BalioztatuBtn"
                    Grid.Row="10" Grid.Column="2"
                    Text="Balioztatu emaitza"
                    BackgroundColor="#A78BFA"
                    TextColor="#1B1B1F"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnBalioztatuClicked" />

        </Grid>
    </ScrollView>

</ContentPage>
