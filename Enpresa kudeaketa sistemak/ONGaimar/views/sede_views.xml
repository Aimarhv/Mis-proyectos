<odoo>
    <record id="view_ong_sede_list" model="ir.ui.view">
        <field name="name">ong.sede.list</field>
        <field name="model">ong.sede</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="ciudad"/>
                <field name="pais"/>
                <field name="direccion"/>
                <field name="telefono"/>
                <field name="direct"/>
            </list>
        </field>
    </record>

    <record id="view_ong_sede_form" model="ir.ui.view">
        <field name="name">ong.sede.form</field>
        <field name="model">ong.sede</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="ciudad"/>
                            <field name="pais"/>
                        </group>
                        <group>
                            <field name="direccion"/>
                            <field name="telefono"/>
                            <field name="direct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Proiektuak">
                            <field name="proyecto_ids">
                                <list>
                                    <field name="cod"/>
                                    <field name="titulo"/>
                                    <field name="inicio"/>
                                    <field name="fin"/>
                                    <field name="presup"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ong_sede_search" model="ir.ui.view">
        <field name="name">ong.sede.search</field>
        <field name="model">ong.sede</field>
        <field name="arch" type="xml">
            <search>
    <field name="ciudad"/>
    <field name="pais"/>
    <filter name="filter_ciudad" string="Herria dutenak" domain="[('ciudad', '!=', False)]"/>
    <filter name="filter_pais" string="Herrialdea dutenak" domain="[('pais', '!=', False)]"/>
    <separator/>
    <filter name="group_ciudad" string="Herria" context="{'group_by': 'ciudad'}"/>
    <filter name="group_pais" string="Herrialdea" context="{'group_by': 'pais'}"/>
</search>
        </field>
    </record>

    <record id="action_ong_sede" model="ir.actions.act_window">
        <field name="name">Egoitzak</field>
        <field name="res_model">ong.sede</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>