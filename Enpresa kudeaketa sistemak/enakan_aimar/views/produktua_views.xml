<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_produktua_list" model="ir.ui.view">
        <field name="name">enkan.produktua.list</field>
        <field name="model">enkan.produktua</field>
        <field name="arch" type="xml">
            <tree>
                <field name="kodea"/>
                <field name="izena"/>
                <field name="deskribapena"/>
                <field name="lotea_id"/>
            </tree>
        </field>
    </record>

    <record id="view_produktua_form" model="ir.ui.view">
        <field name="name">enkan.produktua.form</field>
        <field name="model">enkan.produktua</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="argazkia" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="kodea"/>
                            <field name="izena"/>
                            <field name="lotea_id"/>
                        </group>
                        <group>
                            <field name="deskribapena"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_produktua_kanban" model="ir.ui.view">
        <field name="name">enkan.produktua.kanban</field>
        <field name="model">enkan.produktua</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="kodea"/>
                <field name="izena"/>
                <field name="lotea_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-4">
                                    <img t-att-src="kanban_image('enkan.produktua', 'argazkia', record.id.raw_value)"
                                         class="img-fluid" alt="Argazkia"/>
                                </div>
                                <div class="col-8">
                                    <strong><field name="izena"/></strong>
                                    <div>Kodea: <field name="kodea"/></div>
                                    <div t-if="record.lotea_id.raw_value">Lotea: <field name="lotea_id"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_produktua_search" model="ir.ui.view">
        <field name="name">enkan.produktua.search</field>
        <field name="model">enkan.produktua</field>
        <field name="arch" type="xml">
            <search>
                <field name="kodea"/>
                <field name="izena"/>
                <field name="lotea_id"/>
                <group expand="0" string="Multzokatu">
                    <filter name="group_lotea" string="Lotea" context="{'group_by': 'lotea_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_produktua" model="ir.actions.act_window">
        <field name="name">Produktuak</field>
        <field name="res_model">enkan.produktua</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
