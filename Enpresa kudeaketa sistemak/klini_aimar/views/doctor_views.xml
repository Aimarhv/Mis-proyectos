<odoo>
    <record id="klini_doctor_tree" model="ir.ui.view">
        <field name="name">klini.doctor.tree</field>
        <field name="model">klini.doctor</field>
        <field name="arch" type="xml">
            <list><field name="codigo"/><field name="nombre"/><field name="espec"/></list>
        </field>
    </record>
    <record id="klini_doctor_form" model="ir.ui.view">
        <field name="name">klini.doctor.form</field>
        <field name="model">klini.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="codigo"/><field name="nombre"/><field name="espec"/>
                    </group>
                    <notebook>
                        <page string="Unidades a cargo">
                            <field name="unidad_ids"><list><field name="identificador"/><field name="nombre"/><field name="planta"/></list></field>
                        </page>
                        <page string="Atenciones">
                            <field name="atencion_ids"><list><field name="paciente_id"/><field name="fecha"/><field name="sintoma"/><field name="trat"/></list></field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="klini_doctor_kanban" model="ir.ui.view">
        <field name="name">klini.doctor.kanban</field>
        <field name="model">klini.doctor</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="codigo"/><field name="nombre"/><field name="espec"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="nombre"/></strong>
                            <div>Código: <field name="codigo"/></div>
                            <div>Especialidad: <field name="espec"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="klini_doctor_search" model="ir.ui.view">
        <field name="name">klini.doctor.search</field>
        <field name="model">klini.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/><field name="codigo"/><field name="espec"/>
                <filter name="g_espec" string="Especialidad" context="{'group_by': 'espec'}"/>
            </search>
        </field>
    </record>
    <record id="klini_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctores</field>
        <field name="res_model">klini.doctor</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
