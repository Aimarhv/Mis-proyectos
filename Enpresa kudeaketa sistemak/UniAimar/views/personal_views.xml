<odoo>
    <record id="view_uni_personal_list" model="ir.ui.view">
        <field name="name">uni.personal.list</field>
        <field name="model">uni.personal</field>
        <field name="arch" type="xml">
            <list>
                <field name="pid"/>
                <field name="nombre"/>
                <field name="telefonoa"/>
                <field name="email"/>
                <field name="unidad"/>
                <field name="cat"/>
            </list>
        </field>
    </record>

    <record id="view_uni_personal_form" model="ir.ui.view">
        <field name="name">uni.personal.form</field>
        <field name="model">uni.personal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Pertsona">
                            <field name="pid"/>
                            <field name="nombre"/>
                            <field name="dir"/>
                            <field name="telefonoa"/>
                            <field name="email"/>
                        </group>
                        <group string="Langilea">
                            <field name="unidad"/>
                            <field name="cat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_personal" model="ir.actions.act_window">
        <field name="name">Langileak</field>
        <field name="res_model">uni.personal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>