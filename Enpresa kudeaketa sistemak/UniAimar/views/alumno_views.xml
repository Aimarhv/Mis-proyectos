<odoo>
    <record id="view_uni_alumno_list" model="ir.ui.view">
        <field name="name">uni.alumno.list</field>
        <field name="model">uni.alumno</field>
        <field name="arch" type="xml">
            <list>
                <field name="pid"/>
                <field name="nombre"/>
                <field name="telefonoa"/>
                <field name="email"/>
                <field name="exp"/>
                <field name="titulacion"/>
                <field name="centro_id"/>
            </list>
        </field>
    </record>

    <record id="view_uni_alumno_form" model="ir.ui.view">
        <field name="name">uni.alumno.form</field>
        <field name="model">uni.alumno</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Pertsona">
                            <field name="pid"/>
                            <field name="nombre"/>
                            <field name="dir"/>
                            <field name="telefonoa"/>
                            <field name="email"/>
                        </group>
                        <group string="Ikaslea">
                            <field name="exp"/>
                            <field name="titulacion"/>
                            <field name="centro_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_alumno" model="ir.actions.act_window">
        <field name="name">Ikasleak</field>
        <field name="res_model">uni.alumno</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>