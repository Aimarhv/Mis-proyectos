<odoo>
    <record id="view_uni_profesor_list" model="ir.ui.view">
        <field name="name">uni.profesor.list</field>
        <field name="model">uni.profesor</field>
        <field name="arch" type="xml">
            <list>
                <field name="pid"/>
                <field name="nombre"/>
                <field name="telefonoa"/>
                <field name="email"/>
                <field name="dept"/>
                <field name="ded"/>
            </list>
        </field>
    </record>

    <record id="view_uni_profesor_form" model="ir.ui.view">
        <field name="name">uni.profesor.form</field>
        <field name="model">uni.profesor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Pertsona">
                            <field name="pid"/>
                            <field name="nombre"/>
                            <field name="dir"/>
                            <field name="telefonoa"/>
                            <field name="email"/>
                        </group>
                        <group string="Irakaslea">
                            <field name="dept"/>
                            <field name="ded"/>
                            <field name="centro_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_profesor" model="ir.actions.act_window">
        <field name="name">Irakasleak</field>
        <field name="res_model">uni.profesor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>