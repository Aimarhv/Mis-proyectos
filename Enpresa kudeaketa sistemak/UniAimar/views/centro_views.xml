<odoo>
    <record id="view_uni_centro_list" model="ir.ui.view">
        <field name="name">uni.centro.list</field>
        <field name="model">uni.centro</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombrec"/>
            </list>
        </field>
    </record>

    <record id="view_uni_centro_form" model="ir.ui.view">
        <field name="name">uni.centro.form</field>
        <field name="model">uni.centro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombrec"/>
                    </group>
                    <notebook>
                        <page string="Ikasleak">
                            <field name="alumno_ids">
                                <list>
                                    <field name="nombre"/>
                                    <field name="exp"/>
                                    <field name="titulacion"/>
                                </list>
                            </field>
                        </page>
                        <page string="Irakasleak">
                            <field name="profesor_ids">
                                <list>
                                    <field name="nombre"/>
                                    <field name="dept"/>
                                    <field name="ded"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_centro" model="ir.actions.act_window">
        <field name="name">Ikastetxeak</field>
        <field name="res_model">uni.centro</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>