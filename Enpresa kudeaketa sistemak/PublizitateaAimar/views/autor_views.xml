<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="publizitatea_autor_view_list" model="ir.ui.view">
        <field name="name">publizitatea.autor.list</field>
        <field name="model">publizitatea.autor</field>
        <field name="arch" type="xml">
            <list>
                <field name="izena"/>
                <field name="email"/>
                <field name="adscrirp"/>
            </list>
        </field>
    </record>

    <record id="publizitatea_autor_view_form" model="ir.ui.view">
        <field name="name">publizitatea.autor.form</field>
        <field name="model">publizitatea.autor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="izena"/>
                        <field name="email"/>
                        <field name="adscrirp"/>
                        <field name="articulo_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="publizitatea_autor_action" model="ir.actions.act_window">
        <field name="name">Egileak</field>
        <field name="res_model">publizitatea.autor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>