<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Titulua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/barra_fondo"
        android:gravity="center_vertical|start"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="@string/titulua"
        android:textColor="@color/barra_texto"
        android:drawableStart="@drawable/ic_android_black_24dp"
        android:drawablePadding="12dp"
        android:textSize="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">


        <EditText
            android:id="@+id/etIzena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:hint="@string/izena"
            android:layout_marginTop="16dp"
            android:gravity="left"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/kalkulatu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:text="@string/kalkulatu"
            android:textColor="@color/grey"/>
        <Button
            android:id="@+id/atera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:text="@string/atera"
            android:textColor="@color/grey"/>


    </LinearLayout>
</LinearLayout>