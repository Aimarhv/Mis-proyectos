<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/ivTriangelua"
            android:layout_width="280dp"
            android:layout_height="200dp"
            android:contentDescription="@string/triangelua"
            android:src="@drawable/triangelua" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="85dp"
            android:text="@string/C"
            android:textColor="#0B6A9B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="150dp"
            android:layout_marginTop="75dp"
            android:text="@string/A"
            android:textColor="#0B6A9B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="140dp"
            android:layout_marginTop="172dp"
            android:text="@string/B"
            android:textColor="#0B6A9B"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKateto_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etKateto_a"
                android:text="@string/Kateto_a"
                android:textColor="#212121"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/etKateto_a"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKateto_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etKateto_b"
                android:text="@string/Kateto_b"
                android:textColor="#212121"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/etKateto_b"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGarbitu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/garbitu" />

            <Button
                android:id="@+id/btnKalkulatu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kalkulatu" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmaitza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>