<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <Button
        android:id="@+id/btnAlerta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/Alerta"
        style="@style/Style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnBaieztapena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/Baieztapena"
        style="@style/Style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAlerta" />

    <Button
        android:id="@+id/btnSimple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/Simple"
        style="@style/Style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBaieztapena" />

    <Button
        android:id="@+id/btnMultiple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/Multiple"
        style="@style/Style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSimple" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>