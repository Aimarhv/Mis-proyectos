<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    tools:context=".MainActivity">



    <TextView
        android:id="@+id/Titulua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/titulua"
        android:textColor="#212121"
        android:textSize="28sp" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvZenbakia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/etZenbakia"
            android:text="@string/zenbakia"
            android:textColor="@color/black"
            android:textSize="18sp"/>

        <EditText
            android:id="@+id/etZenbakia"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEgiaztatu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/exekutatu" />

        <Button
            android:id="@+id/btnHustu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/hustu" />

        <Button
            android:id="@+id/btnIrten"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/irten" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMezua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minLines="3"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textAlignment="center"/>
</LinearLayout>









