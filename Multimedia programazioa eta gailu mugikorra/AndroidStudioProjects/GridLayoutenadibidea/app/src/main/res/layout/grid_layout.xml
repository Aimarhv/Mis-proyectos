<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alignmentMode="alignBounds"
    android:columnCount="4"
    android:rowCount="4"
    android:padding="8dp">


    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="0" android:layout_column="0" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="7" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="0" android:layout_column="1" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="8" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="0" android:layout_column="2" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="9" />
    <TextView style="@style/BotonCalculadora.Rojo" android:layout_row="0" android:layout_column="3" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="÷" />


    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="1" android:layout_column="0" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="4" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="1" android:layout_column="1" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="5" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="1" android:layout_column="2" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="6" />
    <TextView style="@style/BotonCalculadora.Rojo" android:layout_row="1" android:layout_column="3" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="×" />


    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="2" android:layout_column="0" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="1" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="2" android:layout_column="1" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="2" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="2" android:layout_column="2" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="3" />
    <TextView style="@style/BotonCalculadora.Rojo" android:layout_row="2" android:layout_column="3" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="-" />


    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="3" android:layout_column="0" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="." />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="3" android:layout_column="1" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="0" />
    <TextView style="@style/BotonCalculadora.Azul" android:layout_row="3" android:layout_column="2" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="=" />
    <TextView style="@style/BotonCalculadora.Rojo" android:layout_row="3" android:layout_column="3" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:text="+" />

</GridLayout>